# Non-secret public configuration. Blank IDs keep third-party measurement disabled.
NEXT_PUBLIC_SITE_URL=https://www.reidasvendas.com.br
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=
NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=false
WHATSAPP_NUMBER=5516992333344
NEXT_PUBLIC_WA_NUMBER=5516992333344
# Optional GTM is documented, not loaded alongside the direct GA4 adapter.
NEXT_PUBLIC_GTM_ID=

# Server only. Configure in Vercel encrypted environment settings, never client code.
CRM_API_URL=
CRM_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=
META_GRAPH_VERSION=
SENTRY_DSN=

# Optional identity fields; publish only verified business data.
BUSINESS_LEGAL_NAME=
BUSINESS_CNPJ=
BUSINESS_ADDRESS=
PRIVACY_CONTACT_EMAIL=

# Subscription offer: remains disabled until real terms and provider configuration are approved.
SUBSCRIPTIONS_OFFER_APPROVED=false
SUBSCRIPTIONS_TERMS_APPROVED=false
SUBSCRIPTIONS_TERMS_VERSION=
# This build uses hosted Stripe Checkout. An arbitrary PAYMENT_PROVIDER_URL is never a redirect target.
PAYMENT_PROVIDER_URL=https://checkout.stripe.com
# Generic contract field; the Stripe adapter reads STRIPE_WEBHOOK_SECRET below.
PAYMENT_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=
# test for local/preview; live only after a controlled real production validation.
STRIPE_MODE=test
STRIPE_PRICE_ESSENCIAL_MONTHLY=
STRIPE_PRICE_ESSENCIAL_ANNUAL=
STRIPE_PRICE_ESSENCIAL_SETUP=
STRIPE_PRICE_PROFISSIONAL_MONTHLY=
STRIPE_PRICE_PROFISSIONAL_ANNUAL=
STRIPE_PRICE_PROFISSIONAL_SETUP=
STRIPE_PRICE_ESCALA_MONTHLY=
STRIPE_PRICE_ESCALA_ANNUAL=
STRIPE_PRICE_ESCALA_SETUP=
