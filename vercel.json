{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm turbo run build --filter=web",
  "outputDirectory": "apps/web/dist",
  "git": {
    "deploymentEnabled": {
      "dependabot/**": false
    }
  },
  "rewrites": [
    {
      "source": "/api/leads/stats",
      "destination": "/api/leads"
    },
    {
      "source": "/api/leads/verticals",
      "destination": "/api/leads"
    },
    {
      "source": "/api/leads/:id",
      "destination": "/api/leads"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.reidasvendas.com.br"
        }
      ],
      "destination": "https://reidasvendas.com.br/:path*",
      "statusCode": 301
    },
    {
      "source": "/recursos",
      "destination": "/blog",
      "statusCode": 301
    },
    {
      "source": "/servicos",
      "destination": "/solucoes",
      "statusCode": 301
    },
    {
      "source": "/servicos/site-conversao-local",
      "destination": "/solucoes/site-institucional-premium",
      "statusCode": 301
    },
    {
      "source": "/servicos/funis-e-automacao",
      "destination": "/solucoes/funil-de-qualificacao",
      "statusCode": 301
    },
    {
      "source": "/servicos/aplicativos-e-saas",
      "destination": "/solucoes/app-para-empresas",
      "statusCode": 301
    },
    {
      "source": "/servicos/google-e-presenca-local",
      "destination": "/solucoes/seo-local-google-business",
      "statusCode": 301
    },
    {
      "source": "/servicos/infraestrutura-digital",
      "destination": "/solucoes/infraestrutura-digital",
      "statusCode": 301
    },
    {
      "source": "/servicos/integracao-whatsapp",
      "destination": "/solucoes/automacao-whatsapp",
      "statusCode": 301
    },
    {
      "source": "/servicos/:slug",
      "destination": "/solucoes",
      "statusCode": 301
    },
    {
      "source": "/modelos",
      "destination": "/solucoes",
      "statusCode": 301
    },
    {
      "source": "/segmentos",
      "destination": "/solucoes",
      "statusCode": 301
    },
    {
      "source": "/segmentos/clinicas",
      "destination": "/solucoes/site-para-clinicas",
      "statusCode": 301
    },
    {
      "source": "/segmentos/odontologia",
      "destination": "/solucoes/site-para-dentistas",
      "statusCode": 301
    },
    {
      "source": "/segmentos/estetica",
      "destination": "/solucoes/site-para-clinicas",
      "statusCode": 301
    },
    {
      "source": "/segmentos/restaurantes",
      "destination": "/solucoes/site-para-restaurantes",
      "statusCode": 301
    },
    {
      "source": "/segmentos/oficinas-mecanicas",
      "destination": "/solucoes/site-para-profissionais-liberais",
      "statusCode": 301
    },
    {
      "source": "/segmentos/pet-shop",
      "destination": "/solucoes/site-institucional-premium",
      "statusCode": 301
    },
    {
      "source": "/segmentos/advocacia",
      "destination": "/solucoes/site-para-advogados",
      "statusCode": 301
    },
    {
      "source": "/segmentos/imobiliarias",
      "destination": "/solucoes/site-para-imobiliarias",
      "statusCode": 301
    },
    {
      "source": "/segmentos/escolas-e-cursos",
      "destination": "/solucoes/site-institucional-premium",
      "statusCode": 301
    },
    {
      "source": "/segmentos/servicos-locais",
      "destination": "/solucoes/site-para-profissionais-liberais",
      "statusCode": 301
    },
    {
      "source": "/segmentos/:slug",
      "destination": "/solucoes",
      "statusCode": 301
    },
    {
      "source": "/projetos",
      "destination": "/portfolio",
      "statusCode": 301
    },
    {
      "source": "/privacy",
      "destination": "/politica",
      "statusCode": 301
    },
    {
      "source": "/privacidade",
      "destination": "/politica",
      "statusCode": 301
    },
    {
      "source": "/templates",
      "destination": "/demonstracoes",
      "statusCode": 301
    },
    {
      "source": "/builder",
      "destination": "/solucoes",
      "statusCode": 301
    },
    {
      "source": "/extensions",
      "destination": "/solucoes",
      "statusCode": 301
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/solucoes",
      "statusCode": 301
    },
    {
      "source": "/blog/infraestrutura-de-vendas-digitais",
      "destination": "/blog/um-projeto-um-deploy-um-dominio",
      "statusCode": 301
    },
    {
      "source": "/blog/automacao-inteligente-para-negocios-locais",
      "destination": "/blog/presenca-digital-o-que-e",
      "statusCode": 301
    },
    {
      "source": "/blog/design-premium-ou-template",
      "destination": "/blog/presenca-digital-o-que-e",
      "statusCode": 301
    },
    {
      "source": "/solucoes/site-para-dentistas-em-campinas",
      "destination": "/solucoes/site-para-dentistas",
      "statusCode": 301
    },
    {
      "source": "/solucoes/site-para-dentistas-em-sorocaba",
      "destination": "/solucoes/site-para-dentistas",
      "statusCode": 301
    },
    {
      "source": "/solucoes/site-para-clinicas-em-campinas",
      "destination": "/solucoes/site-para-clinicas",
      "statusCode": 301
    },
    {
      "source": "/solucoes/landing-page-para-advogados-em-sao-paulo",
      "destination": "/solucoes/landing-page",
      "statusCode": 301
    },
    {
      "source": "/index.php",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/wp/servicos",
      "destination": "/solucoes",
      "statusCode": 301
    },
    {
      "source": "/home",
      "destination": "/",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(videos|imagens)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(favicon\\.svg|logo.*\\.svg|manifest\\.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://www.googletagmanager.com https://www.google-analytics.com; media-src 'self'; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com; frame-src 'none'; object-src 'none'; worker-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
