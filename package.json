{
  "name": "reidasvendas",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check": "turbo run check",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "a11y": "turbo run a11y",
    "storybook": "turbo run storybook",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "design:lint": "pnpm dlx @google/design.md lint DESIGN.md",
    "ci": "pnpm check && pnpm lint && pnpm test && pnpm build:web && pnpm -C apps/web e2e && pnpm a11y",
    "build:web": "turbo run build --filter=web"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "axe-core": "^4.13.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1",
      "ws": ">=8.20.1",
      "uuid": ">=11.1.1",
      "@babel/core": ">=7.29.6",
      "ajv@^6.0.0": "6.15.0",
      "ajv@^8.0.0": ">=8.18.0",
      "js-yaml": ">=4.3.1",
      "minimatch@^10": ">=10.2.3",
      "nanoid": ">=3.3.18",
      "postcss": ">=8.5.23",
      "react-router": ">=7.18.2",
      "react-router-dom": ">=7.18.2",
      "smol-toml": ">=1.6.1",
      "tar": ">=7.5.21",
      "undici": ">=6.28.0",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "brace-expansion@5": "5.0.9"
    }
  }
}
